---
interface Props {
  name: "infrastructure" | "drought" | "quality" | "flood";
}

const { name } = Astro.props;
---

<svg class="agent-icon" viewBox="0 0 48 48" aria-hidden="true">
  {name === "infrastructure" && (
    <>
      <path d="M7 13h12v22H7zM29 13h12v22H29zM19 20h10M19 28h10" />
      <path class="agent-icon__flow" d="M4 39c8-5 15-5 22 0s13 5 19 0" />
      <circle cx="34" cy="20" r="2.5" />
    </>
  )}
  {name === "drought" && (
    <>
      <path d="M6 32c7-8 13-12 19-12s11 4 17 12M8 38c7-5 13-7 18-7s10 2 16 7" />
      <path d="M24 7c-4 6-7 10-7 14a7 7 0 0 0 14 0c0-4-3-8-7-14Z" />
      <circle cx="38" cy="12" r="2.5" />
    </>
  )}
  {name === "quality" && (
    <>
      <path d="M24 5C18 14 12 21 12 29a12 12 0 0 0 24 0c0-8-6-15-12-24Z" />
      <path class="agent-icon__flow" d="M15 30c5-3 8 2 13-1s7 0 9 2" />
      <circle cx="29" cy="21" r="2.5" />
      <circle cx="20" cy="26" r="1.5" />
    </>
  )}
  {name === "flood" && (
    <>
      <path d="M7 15h13v12H7zM28 10h13v17H28zM11 27v6M35 27v6" />
      <path class="agent-icon__flow" d="M4 34c7-4 13-4 20 0s13 4 20 0M4 41c7-4 13-4 20 0s13 4 20 0" />
      <circle cx="40" cy="21" r="2.5" />
    </>
  )}
</svg>

<style>
  .agent-icon {
    fill: none;
    height: 3rem;
    overflow: visible;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.45;
    width: 3rem;
  }

  .agent-icon circle { fill: var(--hs-signal); stroke: none; }
  .agent-icon__flow { stroke: var(--hs-signal); }
</style>
