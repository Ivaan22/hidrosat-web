---
import Brand from "./Brand.astro";

const links = [
  ["Atlas Argentina", "/atlas/"],
  ["Misión", "#mision"],
  ["Agentes", "#agentes"],
  ["Cómo funciona", "#como-funciona"],
  ["HidroOrbit", "#hidroorbit"],
];
---

<header class="site-header" data-site-header>
  <div class="site-header__inner shell">
    <Brand inverse />
    <nav class="site-nav" aria-label="Navegación principal">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="site-header__cta" href="/atlas/">Explorar Atlas <span aria-hidden="true">↗</span></a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú" data-menu-button>
      <span></span><span></span>
    </button>
  </div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Navegación móvil" data-mobile-menu>
    <div class="mobile-menu__inner shell">
      {links.map(([label, href], index) => (
        <a href={href}><span>{String(index + 1).padStart(2, "0")}</span>{label}</a>
      ))}
      <a class="button button--signal" href="/atlas/">Explorar Atlas</a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    color: var(--hs-paper);
    left: 0;
    position: fixed;
    right: 0;
    top: 0;
    transition: background-color 220ms ease, box-shadow 220ms ease, color 220ms ease;
    z-index: 50;
  }

  .site-header::after {
    background: linear-gradient(90deg, rgb(245 248 246 / 0.18), rgb(245 248 246 / 0));
    bottom: 0;
    content: "";
    height: 1px;
    left: 4vw;
    position: absolute;
    right: 4vw;
  }

  .site-header[data-scrolled] {
    background: color-mix(in srgb, var(--hs-paper) 92%, transparent);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--hs-abyss) 13%, transparent);
    color: var(--hs-abyss);
    backdrop-filter: blur(18px);
  }

  .site-header[data-scrolled]::after { opacity: 0; }
  .site-header[data-scrolled] :global(.brand) { color: var(--hs-abyss); }
  .site-header[data-scrolled] :global(.brand__orbit) { stroke: var(--hs-paper); }
  .site-header[data-scrolled] :global(.brand__node) { stroke: var(--hs-paper); }

  .site-header__inner {
    align-items: center;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    min-height: 5.5rem;
  }

  .site-nav { display: flex; gap: clamp(1.1rem, 2.2vw, 2.4rem); }
  .site-nav a {
    color: inherit;
    font-size: 0.78rem;
    font-weight: 560;
    min-height: 2.75rem;
    padding-top: 0.9rem;
    text-decoration: none;
  }
  .site-nav a:hover { color: var(--hs-signal); }

  .site-header__cta {
    align-items: center;
    border-bottom: 1px solid currentColor;
    color: inherit;
    display: inline-flex;
    font-size: 0.72rem;
    font-weight: 620;
    gap: 0.7rem;
    justify-self: end;
    min-height: 2.75rem;
    padding-top: 0.1rem;
    text-decoration: none;
  }
  .site-header__cta span { color: var(--hs-signal); }

  .menu-button {
    align-items: center;
    background: transparent;
    border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    border-radius: 50%;
    color: inherit;
    display: none;
    height: 2.9rem;
    justify-content: center;
    justify-self: end;
    padding: 0;
    position: relative;
    width: 2.9rem;
  }
  .menu-button span {
    background: currentColor;
    height: 1px;
    position: absolute;
    transition: transform 180ms ease;
    width: 1.2rem;
  }
  .menu-button span:first-child { transform: translateY(-4px); }
  .menu-button span:last-child { transform: translateY(4px); }
  .menu-button[aria-expanded="true"] span:first-child { transform: rotate(45deg); }
  .menu-button[aria-expanded="true"] span:last-child { transform: rotate(-45deg); }

  .mobile-menu {
    background: var(--hs-abyss);
    color: var(--hs-paper);
    display: none;
    height: calc(100dvh - 5.5rem);
    overflow-y: auto;
  }
  .mobile-menu__inner { display: grid; padding-block: 1.5rem 3rem; }
  .mobile-menu a:not(.button) {
    align-items: baseline;
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
    color: inherit;
    display: flex;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 8vw, 2.6rem);
    gap: 1rem;
    min-height: 4.4rem;
    padding-block: 1rem;
    text-decoration: none;
  }
  .mobile-menu a span {
    color: var(--hs-signal);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }
  .mobile-menu .button { margin-top: 2rem; }
  .mobile-menu[data-open] { display: block; }

  @media (max-width: 1050px) {
    .site-header__inner { grid-template-columns: 1fr auto; }
    .site-nav, .site-header__cta { display: none; }
    .menu-button { display: inline-flex; }
  }

  @media (max-width: 600px) {
    .site-header__inner { min-height: 4.9rem; }
    .mobile-menu { height: calc(100dvh - 4.9rem); }
  }
</style>
