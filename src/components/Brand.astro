---
interface Props {
  inverse?: boolean;
  compact?: boolean;
  href?: string;
  label?: string;
}

const {
  inverse = false,
  compact = false,
  href = "#top",
  label = "HIDROSAT, volver al inicio",
} = Astro.props;
---

<a class:list={["brand", { "brand--inverse": inverse, "brand--compact": compact }]} href={href} aria-label={label}>
  <svg class="brand__mark" viewBox="0 0 64 64" aria-hidden="true">
    <path class="brand__drop" d="M32 3C25 13 12 27 9 38.2 5.3 52.2 16.1 61 32 61s26.7-8.8 23-22.8C52 27 39 13 32 3Z"></path>
    <path class="brand__orbit" d="M5.5 47.5C18.8 36.1 35.5 28.7 58.5 25"></path>
    <circle class="brand__node" cx="29" cy="35.7" r="6.5"></circle>
  </svg>
  <span class="brand__name">HIDROSAT</span>
</a>

<style>
  .brand {
    align-items: center;
    color: var(--hs-abyss);
    display: inline-flex;
    gap: 0.65rem;
    text-decoration: none;
  }

  .brand__mark {
    flex: none;
    height: 2.25rem;
    overflow: visible;
    width: 2.25rem;
  }

  .brand__drop { fill: currentColor; }
  .brand__orbit {
    fill: none;
    stroke: var(--hs-paper);
    stroke-linecap: round;
    stroke-width: 7;
  }
  .brand__node {
    fill: var(--hs-signal);
    stroke: var(--hs-paper);
    stroke-width: 3;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 690;
    letter-spacing: 0.105em;
  }

  .brand--inverse { color: var(--hs-paper); }
  .brand--inverse .brand__orbit { stroke: var(--hs-abyss); }
  .brand--inverse .brand__node { stroke: var(--hs-abyss); }
  .brand--compact .brand__name { display: none; }

  @media (max-width: 420px) {
    .brand__name { font-size: 0.9rem; }
  }
</style>
