---
import BaseLayout from "../layouts/BaseLayout.astro";
import Brand from "../components/Brand.astro";

const base = `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="HIDROSAT Atlas Argentina — Exploración hídrica 3D"
  description="Una demostración 3D conceptual para explorar cómo HIDROSAT transforma observación del territorio en mejores preguntas sobre el agua."
>
  <main id="main" class="atlas" data-atlas data-region="federal">
    <canvas class="atlas__scene" data-atlas-scene aria-hidden="true"></canvas>
    <div class="atlas__wash" aria-hidden="true"></div>
    <div class="atlas__grain" aria-hidden="true"></div>
    <div class="atlas__reticle" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

    <header class="atlas__topbar">
      <Brand inverse href={base} label="Volver a la página principal de HIDROSAT" />
      <div class="atlas__identity" aria-label="Identidad del Atlas">
        <span>HIDROSAT · ATLAS</span>
        <small>Argentina · exploración de producto</small>
      </div>
      <div class="atlas__top-actions">
        <button class="atlas__orbit-button" type="button" data-orbit aria-label="Cambiar la orientación del territorio">
          <i aria-hidden="true"></i> Girar territorio
        </button>
        <a class="atlas__return" href={base}>Volver al sitio <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <section class="atlas__intro" aria-labelledby="atlas-title">
      <p class="atlas__eyebrow"><span></span> ATLAS ARGENTINA · DEMO 3D</p>
      <h1 id="atlas-title">Un territorio que <em>se mueve con el agua.</em></h1>
      <p>Elegí una región. Mirá cómo el territorio se abre, seguí los flujos y entendé qué podría ayudarnos a observar mejor.</p>
      <div class="atlas__intro-actions">
        <button class="atlas__play-button" type="button" data-start-tour>
          Empezar recorrido <span aria-hidden="true">↓</span>
        </button>
        <span>Arrastrá el territorio o elegí una región.</span>
      </div>
    </section>

    <section class="atlas__missions" aria-labelledby="missions-title">
      <div class="atlas__panel-heading">
        <div>
          <p id="missions-title">Elegí una región</p>
          <small>Un clic cambia la vista</small>
        </div>
        <span data-mission-counter>01 / 04</span>
      </div>
      <div class="atlas__mission-list" role="group" aria-label="Recorridos disponibles">
        <button class="atlas__mission is-active" type="button" data-region-button="federal" aria-pressed="true">
          <span>01</span><strong>Vista federal</strong><i aria-hidden="true">↗</i>
        </button>
        <button class="atlas__mission" type="button" data-region-button="litoral" aria-pressed="false">
          <span>02</span><strong>Litoral</strong><i aria-hidden="true">↗</i>
        </button>
        <button class="atlas__mission" type="button" data-region-button="cuyo" aria-pressed="false">
          <span>03</span><strong>Cuyo</strong><i aria-hidden="true">↗</i>
        </button>
        <button class="atlas__mission" type="button" data-region-button="patagonia" aria-pressed="false">
          <span>04</span><strong>Patagonia</strong><i aria-hidden="true">↗</i>
        </button>
      </div>
    </section>

    <aside class="atlas__briefing" aria-live="polite" aria-labelledby="briefing-title">
      <div class="atlas__briefing-status"><span></span> RECORRIDO ACTIVO</div>
      <p class="atlas__briefing-number" data-brief-number>01</p>
      <h2 id="briefing-title" data-brief-title>Una vista para empezar.</h2>
      <p data-brief-copy>Argentina es una red de cuencas, infraestructura y comunidades. Esta vista invita a empezar por el territorio antes de sacar conclusiones.</p>
      <div class="atlas__briefing-rule">
        <i aria-hidden="true"></i>
        <p data-brief-rule>El relieve y los flujos son una representación conceptual: no muestran mediciones ni alertas en vivo.</p>
      </div>
    </aside>

    <section class="atlas__how" aria-label="Cómo explorar el Atlas">
      <span class="atlas__how-kicker">Cómo se explora</span>
      <div>
        <p><b>01</b> Elegí una región</p>
        <p><b>02</b> SeguÍ el recorrido</p>
        <p><b>03</b> Volvé a la vista federal</p>
      </div>
    </section>

    <div class="atlas__readout" role="status" aria-live="polite" data-atlas-readout>
      <i aria-hidden="true"></i>
      <p>Preparando la mesa de agua…</p>
    </div>

    <div class="atlas__legend" aria-label="Significado de la demostración">
      <span><i class="atlas__legend-water"></i> Flujo de agua conceptual</span>
      <span><i class="atlas__legend-field"></i> Campo de observación</span>
      <button type="button" data-safety-toggle aria-expanded="false" aria-controls="atlas-safety">Límites de la demo <b aria-hidden="true">+</b></button>
    </div>

    <section class="atlas__safety" id="atlas-safety" hidden data-safety-panel>
      <p><strong>Esto no es una sala de control real.</strong> El territorio, las rutas de agua y los nodos de esta experiencia están diseñados para explicar una idea de producto. Las capas publicadas, la evidencia de campo y cualquier operación sensible requieren fuentes, fecha, contexto y revisión humana.</p>
    </section>

    <p class="atlas__caption">HIDROSAT ATLAS · Experiencia 3D conceptual · No representa alertas, una cartografía operacional ni el estado de infraestructura.</p>
  </main>

  <script>
    type RegionId = "federal" | "litoral" | "cuyo" | "patagonia";
    type ThreeModule = typeof import("three");

    const atlas = document.querySelector<HTMLElement>("[data-atlas]");
    const canvas = document.querySelector<HTMLCanvasElement>("[data-atlas-scene]");
    const readout = document.querySelector<HTMLElement>("[data-atlas-readout] p");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const regions: Record<RegionId, {
      index: string;
      title: string;
      copy: string;
      rule: string;
      point: [number, number];
      rotation: number;
      camera: [number, number, number];
    }> = {
      federal: {
        index: "01",
        title: "Una vista para empezar.",
        copy: "Argentina es una red de cuencas, infraestructura y comunidades. Esta vista invita a empezar por el territorio antes de sacar conclusiones.",
        rule: "El relieve y los flujos son una representación conceptual: no muestran mediciones ni alertas en vivo.",
        point: [0, -0.2],
        rotation: -0.16,
        camera: [0, 8.8, 12.8],
      },
      litoral: {
        index: "02",
        title: "El agua también conecta.",
        copy: "En el Litoral, ríos, humedales y ciudades muestran por qué una mirada de cuenca necesita unir territorio, tiempo y personas.",
        rule: "Una vista 3D no confirma cambios ni reemplaza el conocimiento local, las mediciones o la verificación de campo.",
        point: [0.52, 3.25],
        rotation: -0.42,
        camera: [1.1, 7.3, 10.5],
      },
      cuyo: {
        index: "03",
        title: "Cada gota tiene recorrido.",
        copy: "En Cuyo, el agua superficial, las reservas y la infraestructura abierta hacen visible el valor de comprender recorridos antes de priorizar una acción.",
        rule: "HIDROSAT puede organizar preguntas y evidencia; una persona debe interpretar el contexto y decidir qué verificar.",
        point: [-0.82, 1.75],
        rotation: 0.26,
        camera: [-1.45, 7.1, 10.1],
      },
      patagonia: {
        index: "04",
        title: "Mirar a escala también importa.",
        copy: "La Patagonia recuerda que los cambios hídricos se leen en paisajes extensos, con tiempos distintos y mucha incertidumbre por delante.",
        rule: "Esta experiencia no muestra una alerta, una escena satelital ni una evaluación del estado de un activo real.",
        point: [-0.05, -4.35],
        rotation: 0.12,
        camera: [0.25, 7.4, 10.9],
      },
    };

    const updateReadout = (message: string) => {
      if (readout) readout.textContent = message;
    };

    const updateRegion = (regionId: RegionId, sceneState?: SceneState) => {
      const region = regions[regionId];
      atlas?.setAttribute("data-region", regionId);
      document.querySelectorAll<HTMLButtonElement>("[data-region-button]").forEach((button) => {
        const active = button.dataset.regionButton === regionId;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      document.querySelector<HTMLElement>("[data-mission-counter]")!.textContent = `${region.index} / 04`;
      document.querySelector<HTMLElement>("[data-brief-number]")!.textContent = region.index;
      document.querySelector<HTMLElement>("[data-brief-title]")!.textContent = region.title;
      document.querySelector<HTMLElement>("[data-brief-copy]")!.textContent = region.copy;
      document.querySelector<HTMLElement>("[data-brief-rule]")!.textContent = region.rule;
      updateReadout(`Recorrido ${region.index}: ${region.title}`);
      sceneState?.focus(regionId);
    };

    type SceneState = { focus: (regionId: RegionId) => void; rotate: () => void };

    const mountScene = async () => {
      if (!canvas || !atlas) return;

      const THREE: ThreeModule = await import("three");
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: "high-performance" });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.65));
      renderer.outputColorSpace = THREE.SRGBColorSpace;

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
      const cameraPosition = new THREE.Vector3(0, 8.8, 12.8);
      const cameraGoal = cameraPosition.clone();
      const lookTarget = new THREE.Vector3(0, 0.08, 0);
      const lookGoal = lookTarget.clone();
      camera.position.copy(cameraPosition);

      scene.add(new THREE.HemisphereLight(0xa7e9f6, 0x03121c, 2.1));
      const keyLight = new THREE.DirectionalLight(0x9eefff, 2.7);
      keyLight.position.set(-4, 9, 6);
      scene.add(keyLight);
      const amberLight = new THREE.PointLight(0xb58962, 7, 22, 2);
      amberLight.position.set(4, 3.4, -3);
      scene.add(amberLight);

      const stage = new THREE.Group();
      stage.position.set(0, -0.34, 0);
      scene.add(stage);

      const ground = new THREE.Mesh(
        new THREE.CircleGeometry(13, 96),
        new THREE.MeshBasicMaterial({ color: 0x03131c, transparent: true, opacity: 0.76 }),
      );
      ground.rotation.x = -Math.PI / 2;
      ground.position.y = -0.18;
      stage.add(ground);

      const grid = new THREE.GridHelper(23, 24, 0x0c5267, 0x073247);
      grid.material.transparent = true;
      grid.material.opacity = 0.22;
      grid.position.y = -0.16;
      stage.add(grid);

      const terrainPivot = new THREE.Group();
      terrainPivot.rotation.y = regions.federal.rotation;
      stage.add(terrainPivot);

      const terrain = new THREE.Group();
      terrain.rotation.x = -Math.PI / 2;
      terrainPivot.add(terrain);

      const outline: Array<[number, number]> = [
        [-0.62, 7.45], [-0.16, 7.05], [0.1, 6.2], [-0.32, 5.45], [0.06, 4.65], [-0.44, 3.78], [-0.12, 3.02], [-0.7, 2.15], [-0.34, 1.38], [-0.89, 0.46], [-0.53, -0.3], [-1.08, -1.36], [-0.67, -2.25], [-1.03, -3.18], [-0.55, -4.14], [-0.94, -5.2], [-0.43, -6.16], [-0.8, -7.25], [-0.12, -8.02], [0.34, -7.12], [0.72, -5.95], [0.34, -4.76], [0.95, -3.45], [0.55, -2.11], [1.05, -0.9], [0.58, 0.24], [1.04, 1.47], [0.53, 2.62], [0.77, 3.82], [0.3, 5.03], [0.48, 6.28], [0.08, 7.42],
      ];
      const shape = new THREE.Shape();
      outline.forEach(([x, y], index) => index === 0 ? shape.moveTo(x, y) : shape.lineTo(x, y));
      shape.closePath();

      const terrainGeometry = new THREE.ExtrudeGeometry(shape, { depth: 0.42, bevelEnabled: true, bevelSegments: 2, bevelSize: 0.045, bevelThickness: 0.06, curveSegments: 3 });
      const terrainSurface = new THREE.Mesh(
        terrainGeometry,
        new THREE.MeshStandardMaterial({ color: 0x0b4051, emissive: 0x06232d, emissiveIntensity: 0.92, roughness: 0.61, metalness: 0.36 }),
      );
      terrain.add(terrainSurface);

      const terrainEdges = new THREE.LineSegments(
        new THREE.EdgesGeometry(terrainGeometry, 16),
        new THREE.LineBasicMaterial({ color: 0x5be1f2, transparent: true, opacity: 0.72 }),
      );
      terrainEdges.position.z = 0.01;
      terrain.add(terrainEdges);

      const observationField = new THREE.Mesh(
        new THREE.PlaneGeometry(3.7, 17.5),
        new THREE.MeshBasicMaterial({ color: 0x00b9e8, transparent: true, opacity: 0.075, blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.DoubleSide }),
      );
      observationField.position.set(0.04, -0.2, 0.5);
      observationField.rotation.z = -0.17;
      terrain.add(observationField);

      const fieldLine = new THREE.Mesh(
        new THREE.PlaneGeometry(0.06, 17.7),
        new THREE.MeshBasicMaterial({ color: 0xa9e1eb, transparent: true, opacity: 0.56, blending: THREE.AdditiveBlending, depthWrite: false }),
      );
      fieldLine.position.set(0.04, -0.2, 0.515);
      fieldLine.rotation.z = -0.17;
      terrain.add(fieldLine);

      const waterRoutes: Array<Array<[number, number]>> = [
        [[-0.34, 6.55], [-0.14, 5.48], [0.2, 4.36], [0.45, 3.1], [0.62, 1.85], [0.48, 0.68], [0.68, -0.52]],
        [[-0.6, 3.3], [-0.28, 2.72], [0.1, 2.1], [0.48, 1.42], [0.65, 0.68]],
        [[-0.52, 2.08], [-0.36, 1.32], [-0.16, 0.45], [0.18, -0.52], [0.4, -1.65]],
        [[-0.24, -1.5], [-0.08, -2.48], [-0.25, -3.56], [0.1, -4.7], [0.02, -6.03]],
        [[-0.7, 4.18], [-0.5, 3.62], [-0.46, 2.9], [-0.28, 2.35]],
      ];
      const particleCurves: import("three").CatmullRomCurve3[] = [];
      waterRoutes.forEach((route, index) => {
        const points = route.map(([x, y]) => new THREE.Vector3(x, y, 0.52));
        const curve = new THREE.CatmullRomCurve3(points, false, "centripetal");
        particleCurves.push(curve);
        const tube = new THREE.Mesh(
          new THREE.TubeGeometry(curve, 96, index === 0 ? 0.075 : 0.045, 8, false),
          new THREE.MeshBasicMaterial({ color: index === 0 ? 0x1cd6f4 : 0x00a9d5, transparent: true, opacity: index === 0 ? 0.92 : 0.65, blending: THREE.AdditiveBlending, depthWrite: false }),
        );
        terrain.add(tube);
      });

      const regionPoints: Record<RegionId, [number, number]> = {
        federal: [0.03, -0.1],
        litoral: [0.52, 3.25],
        cuyo: [-0.82, 1.75],
        patagonia: [-0.05, -4.35],
      };
      const regionMarkers = new Map<RegionId, import("three").Group>();
      (Object.entries(regionPoints) as Array<[RegionId, [number, number]]>).forEach(([id, [x, y]]) => {
        const marker = new THREE.Group();
        marker.position.set(x, y, 0.58);
        const ring = new THREE.Mesh(
          new THREE.RingGeometry(0.14, 0.21, 40),
          new THREE.MeshBasicMaterial({ color: id === "federal" ? 0x00b9e8 : 0xa9e1eb, transparent: true, opacity: 0.9, side: THREE.DoubleSide, blending: THREE.AdditiveBlending, depthWrite: false }),
        );
        marker.add(ring);
        const core = new THREE.Mesh(
          new THREE.CircleGeometry(0.055, 28),
          new THREE.MeshBasicMaterial({ color: 0xf5f8f6, transparent: true, opacity: 0.96, side: THREE.DoubleSide }),
        );
        core.position.z = 0.006;
        marker.add(core);
        terrain.add(marker);
        regionMarkers.set(id, marker);
      });

      const particleCount = 78;
      const particlePositions = new Float32Array(particleCount * 3);
      const particleOffsets = Array.from({ length: particleCount }, (_, index) => ({ curve: index % particleCurves.length, offset: (index * 0.173) % 1, speed: 0.03 + (index % 5) * 0.006 }));
      const particleGeometry = new THREE.BufferGeometry();
      particleGeometry.setAttribute("position", new THREE.BufferAttribute(particlePositions, 3));
      const particleField = new THREE.Points(
        particleGeometry,
        new THREE.PointsMaterial({ color: 0xd9fbff, size: 0.047, transparent: true, opacity: 0.88, blending: THREE.AdditiveBlending, depthWrite: false, sizeAttenuation: true }),
      );
      terrain.add(particleField);

      const focusRing = new THREE.Mesh(
        new THREE.RingGeometry(0.26, 0.33, 48),
        new THREE.MeshBasicMaterial({ color: 0x00d9ff, transparent: true, opacity: 0.92, side: THREE.DoubleSide, blending: THREE.AdditiveBlending, depthWrite: false }),
      );
      focusRing.position.z = 0.6;
      terrain.add(focusRing);

      const observationNode = new THREE.Group();
      const nodeRing = new THREE.Mesh(
        new THREE.RingGeometry(0.42, 0.45, 56),
        new THREE.MeshBasicMaterial({ color: 0xb58962, transparent: true, opacity: 0.7, side: THREE.DoubleSide, blending: THREE.AdditiveBlending, depthWrite: false }),
      );
      const nodeCore = new THREE.Mesh(
        new THREE.CircleGeometry(0.075, 32),
        new THREE.MeshBasicMaterial({ color: 0xf0be72, transparent: true, opacity: 0.96, side: THREE.DoubleSide, blending: THREE.AdditiveBlending, depthWrite: false }),
      );
      nodeCore.position.z = 0.01;
      observationNode.add(nodeRing, nodeCore);
      observationNode.position.set(-0.14, 0.28, 0.6);
      terrain.add(observationNode);

      const halo = new THREE.Mesh(
        new THREE.RingGeometry(3.7, 3.75, 96),
        new THREE.MeshBasicMaterial({ color: 0x146781, transparent: true, opacity: 0.38, side: THREE.DoubleSide, blending: THREE.AdditiveBlending, depthWrite: false }),
      );
      halo.rotation.x = -Math.PI / 2;
      halo.position.y = -0.08;
      stage.add(halo);

      let targetRotation = regions.federal.rotation;
      let dragged = false;
      let dragOrigin = 0;
      let rotationOrigin = targetRotation;
      let visible = !document.hidden;
      let frame = 0;

      const localToWorld = ([x, y]: [number, number]) => new THREE.Vector3(x, 0.2, -y);
      const setFocus = (regionId: RegionId) => {
        const region = regions[regionId];
        targetRotation = region.rotation;
        const point = localToWorld(region.point);
        lookGoal.set(point.x * 0.28, 0.1, point.z * 0.28);
        cameraGoal.set(region.camera[0], region.camera[1], region.camera[2]);
        focusRing.position.set(region.point[0], region.point[1], 0.61);
        regionMarkers.forEach((marker, id) => marker.scale.setScalar(id === regionId ? 1.45 : 0.88));
      };

      const resize = () => {
        const rect = atlas.getBoundingClientRect();
        renderer.setSize(rect.width, rect.height, false);
        camera.aspect = rect.width / rect.height;
        camera.updateProjectionMatrix();
      };

      const renderFrame = (time = 0) => {
        const quiet = reducedMotion.matches;
        camera.position.lerp(cameraGoal, quiet ? 1 : 0.052);
        lookTarget.lerp(lookGoal, quiet ? 1 : 0.07);
        terrainPivot.rotation.y += (targetRotation - terrainPivot.rotation.y) * (quiet ? 1 : 0.055);

        const elapsed = time * 0.001;
        if (!quiet) {
          terrainPivot.position.y = Math.sin(elapsed * 0.42) * 0.055;
          observationField.material.opacity = 0.06 + Math.sin(elapsed * 0.37) * 0.017;
          fieldLine.material.opacity = 0.44 + Math.sin(elapsed * 0.7) * 0.14;
          halo.rotation.z += 0.0013;
          observationNode.rotation.z -= 0.013;
          observationNode.scale.setScalar(1 + Math.sin(elapsed * 1.4) * 0.07);
          focusRing.scale.setScalar(1 + Math.sin(elapsed * 1.7) * 0.16);
          particleOffsets.forEach((particle, index) => {
            const point = particleCurves[particle.curve].getPointAt((particle.offset + elapsed * particle.speed) % 1);
            particlePositions[index * 3] = point.x;
            particlePositions[index * 3 + 1] = point.y;
            particlePositions[index * 3 + 2] = point.z + Math.sin(elapsed * 2.2 + index) * 0.014;
          });
          particleGeometry.attributes.position.needsUpdate = true;
        }
        camera.lookAt(lookTarget);
        renderer.render(scene, camera);
        if (!quiet && visible) frame = window.requestAnimationFrame(renderFrame);
      };

      const resume = () => {
        if (frame || reducedMotion.matches || !visible) return;
        frame = window.requestAnimationFrame(renderFrame);
      };
      const pause = () => {
        if (!frame) return;
        window.cancelAnimationFrame(frame);
        frame = 0;
      };
      const refreshMotion = () => {
        pause();
        renderFrame();
        resume();
      };

      const onPointerDown = (event: PointerEvent) => {
        dragged = true;
        dragOrigin = event.clientX;
        rotationOrigin = targetRotation;
        canvas.setPointerCapture?.(event.pointerId);
      };
      const onPointerMove = (event: PointerEvent) => {
        if (!dragged) return;
        targetRotation = rotationOrigin + (event.clientX - dragOrigin) * 0.008;
      };
      const onPointerUp = (event: PointerEvent) => {
        dragged = false;
        canvas.releasePointerCapture?.(event.pointerId);
      };

      canvas.addEventListener("pointerdown", onPointerDown);
      canvas.addEventListener("pointermove", onPointerMove);
      canvas.addEventListener("pointerup", onPointerUp);
      canvas.addEventListener("pointercancel", onPointerUp);
      window.addEventListener("resize", resize);
      document.addEventListener("visibilitychange", () => {
        visible = !document.hidden;
        if (visible) resume(); else pause();
      });
      reducedMotion.addEventListener("change", refreshMotion);

      resize();
      setFocus("federal");
      particleOffsets.forEach((particle, index) => {
        const point = particleCurves[particle.curve].getPointAt(particle.offset);
        particlePositions[index * 3] = point.x;
        particlePositions[index * 3 + 1] = point.y;
        particlePositions[index * 3 + 2] = point.z;
      });
      particleGeometry.attributes.position.needsUpdate = true;
      renderFrame();
      resume();
      atlas.dataset.sceneReady = "";
      updateReadout("Territorio listo. Elegí una región para continuar.");

      return {
        focus: setFocus,
        rotate: () => {
          targetRotation += Math.PI * 0.52;
          updateReadout("Orientación del territorio actualizada.");
        },
      } satisfies SceneState;
    };

    let sceneState: SceneState | undefined;
    const startAtlas = () => {
      const load = () => {
        void mountScene().then((state) => {
          sceneState = state;
        }).catch(() => {
          atlas?.setAttribute("data-scene-issue", "");
          updateReadout("No pudimos iniciar la vista 3D. La idea del Atlas sigue disponible en esta página.");
        });
      };
      window.setTimeout(load, 0);
    };

    document.querySelectorAll<HTMLButtonElement>("[data-region-button]").forEach((button) => {
      button.addEventListener("click", () => {
        const regionId = button.dataset.regionButton as RegionId | undefined;
        if (regionId) updateRegion(regionId, sceneState);
      });
    });
    document.querySelector<HTMLButtonElement>("[data-start-tour]")?.addEventListener("click", () => {
      document.querySelector<HTMLElement>(".atlas__missions")?.scrollIntoView({ behavior: reducedMotion.matches ? "auto" : "smooth", block: "nearest" });
      updateReadout("Elegí una región. Cada recorrido explica una manera de pensar el agua.");
    });
    document.querySelector<HTMLButtonElement>("[data-orbit]")?.addEventListener("click", () => sceneState?.rotate());

    const safetyToggle = document.querySelector<HTMLButtonElement>("[data-safety-toggle]");
    const safetyPanel = document.querySelector<HTMLElement>("[data-safety-panel]");
    safetyToggle?.addEventListener("click", () => {
      const expanded = safetyToggle.getAttribute("aria-expanded") === "true";
