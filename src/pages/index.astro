---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import ObservationLens from "../components/ObservationLens.astro";
import EvidenceCase from "../components/EvidenceCase.astro";
import Footer from "../components/Footer.astro";

const steps = [
  { number: "01", title: "Observar", text: "Integramos escenas satelitales y datos territoriales con controles de calidad y procedencia." },
  { number: "02", title: "Interpretar", text: "Buscamos cambios compatibles con un fenómeno y conservamos explicaciones alternativas." },
  { number: "03", title: "Decidir", text: "Convertimos la evidencia disponible en una prioridad clara, no en un veredicto automático." },
  { number: "04", title: "Verificar", text: "Una persona confirma, descarta o caracteriza el caso con conocimiento de campo." },
  { number: "05", title: "Aprender", text: "El resultado vuelve al sistema sin borrar el historial ni la incertidumbre original." },
];

const domains = [
  { number: "01", title: "Infraestructura y pérdidas", text: "Canales, drenajes, reservorios y sistemas abiertos donde cada inspección necesita foco y contexto." },
  { number: "02", title: "Sequía y ecosistemas", text: "Cambios en agua superficial, vegetación y territorio para acompañar decisiones de anticipación." },
  { number: "03", title: "Calidad de agua", text: "Señales ópticas compatibles con turbidez o floraciones como alerta temprana para muestreo y revisión." },
  { number: "04", title: "Inundaciones y cuencas", text: "Extensión y dinámica del agua para comprender exposición, evolución y prioridades de respuesta." },
];
---

<BaseLayout
  title="HIDROSAT — Del espacio a mejores decisiones sobre el agua"
  description="HIDROSAT convierte observación satelital, datos territoriales y conocimiento humano en evidencia verificable para comprender y proteger el agua."
>
  <Header />
  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero__grid shell">
        <div class="hero__copy" data-reveal>
          <p class="eyebrow"><span></span> Infraestructura de inteligencia hídrica en desarrollo</p>
          <h1 id="hero-title">Del espacio a mejores decisiones sobre el agua.</h1>
          <p class="hero__lede">HIDROSAT combina observación satelital, datos territoriales y conocimiento humano para convertir cambios ambientales en evidencia verificable para la acción.</p>
          <div class="button-row">
            <a class="button button--signal" href="#metodo">Ver cómo funciona <span aria-hidden="true">↘</span></a>
            <a class="text-link" href="#hidroorbit">Conocer HidroOrbit <span aria-hidden="true">→</span></a>
          </div>
          <p class="hero__origin">Nacido en Bahía Blanca. Diseñado para territorios de cualquier escala.</p>
        </div>
        <div class="hero__visual" data-reveal data-delay="1">
          <ObservationLens />
          <ol class="hero__layers" aria-label="Las tres capas de HIDROSAT">
            <li><span>01</span><strong>Observación</strong><small>Qué cambió</small></li>
            <li><span>02</span><strong>Inferencia</strong><small>Qué podría significar</small></li>
            <li><span>03</span><strong>Decisión</strong><small>Qué revisar primero</small></li>
          </ol>
        </div>
      </div>
      <div class="hero__ledger shell" data-reveal>
        <span>Datos con procedencia</span>
        <span>Incertidumbre visible</span>
        <span>Revisión humana</span>
        <span>Proyecto en desarrollo · 2026</span>
      </div>
    </section>

    <section class="mission section" id="mision" aria-labelledby="mission-title">
      <div class="shell mission__grid">
        <div data-reveal>
          <p class="section-index">01 — MISIÓN</p>
          <h2 id="mission-title">La información existe. El desafío es convertirla en capacidad pública.</h2>
        </div>
        <div class="mission__body" data-reveal data-delay="1">
          <p class="lead">Satélites, modelos climáticos, registros territoriales e inspecciones producen señales valiosas. HIDROSAT las organiza con contexto, procedencia e incertidumbre para ayudar a comprender qué cambió y decidir dónde mirar primero.</p>
          <aside class="definition">
            <span>En una frase</span>
            <p>HIDROSAT es la infraestructura. HidroOrbit es su primera solución vertical en investigación y validación.</p>
          </aside>
        </div>
      </div>
      <div class="mission__anti shell" data-reveal>
        <span>HIDROSAT no es</span>
        <ul>
          <li>un satélite</li>
          <li>una aplicación única</li>
          <li>un veredicto automático</li>
        </ul>
      </div>
    </section>

    <section class="method section section--ink" id="metodo" aria-labelledby="method-title">
      <div class="method__contours" aria-hidden="true">
        <svg viewBox="0 0 1500 820" preserveAspectRatio="none">
          <path d="M-50 540c201-164 373-202 564-103 157 82 295 28 421-79 183-156 330-102 615-172" />
          <path d="M-45 630c218-150 379-137 538-54 170 88 301 26 438-72 199-143 358-77 629-153" />
          <path d="M-35 714c209-111 374-88 532-10 182 89 320 43 455-48 194-131 362-67 622-142" />
        </svg>
      </div>
      <div class="shell method__intro" data-reveal>
        <p class="section-index section-index--light">02 — CÓMO FUNCIONA</p>
        <h2 id="method-title">Una imagen no es una explicación.<br />Una inferencia no es una sentencia.</h2>
      </div>
      <ol class="method__steps shell">
        {steps.map((step, index) => (
          <li data-reveal data-delay={String(index % 3)}>
            <span class="method__number">{step.number}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="method__principle shell" data-reveal>
        <span>Principio operativo</span>
        <p>Cada señal, con su fuente. Cada alerta, con su incertidumbre. Cada decisión, humana.</p>
      </div>
    </section>

    <section class="domains section" id="capacidades" aria-labelledby="domains-title">
      <div class="shell domains__heading" data-reveal>
        <p class="section-index">03 — CAPACIDADES</p>
        <div>
          <h2 id="domains-title">Una infraestructura.<br />Cuatro dominios iniciales.</h2>
          <p>No son cuatro productos terminados. Son áreas de desarrollo que comparten datos, método y trazabilidad.</p>
        </div>
      </div>
      <div class="domains__list shell">
        {domains.map((domain) => (
          <article data-reveal>
            <span class="domains__number">{domain.number}</span>
            <div>
              <span class="status-label">Dominio de desarrollo</span>
              <h3>{domain.title}</h3>
            </div>
            <p>{domain.text}</p>
            <span class="domains__arrow" aria-hidden="true">↗</span>
          </article>
        ))}
      </div>
    </section>

    <section class="orbit section" id="hidroorbit" aria-labelledby="orbit-title">
      <div class="shell orbit__grid">
        <div class="orbit__copy" data-reveal>
          <p class="section-index">04 — PRIMER PRODUCTO</p>
          <span class="product-status"><i></i> En investigación y validación</span>
          <h2 id="orbit-title">Qué tramo revisar primero, y por qué.</h2>
          <p class="lead">HidroOrbit organiza señales satelitales y territoriales en casos de inspección para canales, drenajes, reservorios e infraestructura abierta.</p>
          <p>Cada caso puede reunir la observación, la fecha, el contexto, explicaciones alternativas, incertidumbre y estado de verificación.</p>
          <div class="orbit__boundary">
            <span>El límite importa</span>
            <p>Una señal compatible con humedad o agua fuera de cauce no confirma por sí sola una fuga ni su causa.</p>
          </div>
          <a class="text-link" href="#evidencia">Ver cómo tratamos la evidencia <span aria-hidden="true">↓</span></a>
        </div>
        <div class="orbit__demo" data-reveal data-delay="1">
          <EvidenceCase />
        </div>
      </div>
    </section>

    <section class="evidence section" id="evidencia" aria-labelledby="evidence-title">
      <div class="shell evidence__heading" data-reveal>
        <p class="section-index">05 — CREDIBILIDAD</p>
        <h2 id="evidence-title">La incertidumbre también es información.</h2>
        <p class="lead">Cuando los datos no alcanzan, el sistema debe poder decirlo.</p>
      </div>
      <div class="evidence__layers shell" data-reveal>
        <article>
          <span class="evidence__layer-number">01</span>
          <span class="evidence__state evidence__state--observed">Observado</span>
          <h3>La señal</h3>
          <p>Qué cambió en los datos, con fecha, misión, cobertura válida y condiciones de adquisición.</p>
          <small>Hecho rastreable</small>
        </article>
        <article>
          <span class="evidence__layer-number">02</span>
          <span class="evidence__state evidence__state--inferred">Inferido</span>
          <h3>La interpretación</h3>
          <p>Qué explicaciones son compatibles, qué supuestos intervienen y qué tan concluyente es la evidencia.</p>
          <small>Hipótesis explícita</small>
        </article>
        <article>
          <span class="evidence__layer-number">03</span>
          <span class="evidence__state evidence__state--human">Decisión humana</span>
          <h3>La acción</h3>
          <p>Qué conviene revisar, quién lo evaluó y qué resultado se confirmó o descartó en territorio.</p>
          <small>Responsabilidad visible</small>
        </article>
      </div>
      <div class="evidence__promise shell" data-reveal>
        <p>No prometemos ver debajo del asfalto, detectar causas automáticamente ni reemplazar una inspección.</p>
        <p>Diseñamos para observar cambios, priorizar preguntas y conservar la historia completa de cada decisión.</p>
      </div>
    </section>

    <section class="open-core section section--deep" id="tecnologia" aria-labelledby="open-title">
      <div class="shell open-core__grid">
        <div data-reveal>
          <p class="section-index section-index--light">06 — NÚCLEO TECNOLÓGICO</p>
          <h2 id="open-title">Diseñado para ser abierto, portable y auditable.</h2>
        </div>
        <div class="open-core__copy" data-reveal data-delay="1">
          <p class="lead">HIDROSAT se diseña para conservar la procedencia desde la escena satelital hasta el caso que llega a una persona.</p>
          <p>La arquitectura proyecta estándares abiertos, conectores reemplazables y procesos reproducibles para reducir la dependencia de un único proveedor. La apertura pública se formalizará con repositorios y licencias explícitas.</p>
        </div>
      </div>
      <div class="lineage shell" data-reveal>
        <div><span>01</span><strong>Fuente</strong><small>Escena + metadatos</small></div>
        <i aria-hidden="true"></i>
        <div><span>02</span><strong>Proceso</strong><small>Versión + parámetros</small></div>
        <i aria-hidden="true"></i>
        <div><span>03</span><strong>Evidencia</strong><small>Señal + contexto</small></div>
        <i aria-hidden="true"></i>
        <div><span>04</span><strong>Caso</strong><small>Decisión + resultado</small></div>
      </div>
      <div class="open-core__standards shell" data-reveal>
        <span>STAC</span><span>COG</span><span>GeoParquet</span><span>PostGIS</span><span>Python</span>
        <small>Base tecnológica prevista; su uso operativo dependerá de cada producto y piloto.</small>
      </div>
      <p class="open-core__labs shell" data-reveal><strong>HIDROSAT Labs</strong> es el entorno interno donde estas decisiones se investigan, comparan y documentan antes de llegar a un producto.</p>
    </section>

    <section class="project-state section" id="estado" aria-labelledby="state-title">
      <div class="shell project-state__grid">
        <div data-reveal>
          <p class="section-index">07 — ESTADO DEL PROYECTO</p>
          <h2 id="state-title">Ambición global.<br />Progreso verificable.</h2>
          <p class="lead">No mostramos métricas de impacto que todavía no existen. Mostramos dónde estamos y qué falta demostrar.</p>
        </div>
        <ol class="project-state__timeline" data-reveal data-delay="1">
          <li class="is-active">
            <span>Ahora</span>
            <div><strong>Fundación y prototipado</strong><p>Arquitectura, investigación, identidad, primeras interfaces y criterios de validación.</p></div>
          </li>
          <li>
            <span>Siguiente</span>
            <div><strong>Territorio piloto</strong><p>Una decisión concreta, datos disponibles y un operador capaz de verificar resultados.</p></div>
          </li>
          <li>
            <span>Después</span>
            <div><strong>Evidencia de utilidad</strong><p>Medir si la priorización mejora el trabajo antes de afirmar impacto o escalar.</p></div>
          </li>
        </ol>
      </div>
    </section>

    <section class="collaborate" id="colaborar" aria-labelledby="collaborate-title">
      <div class="collaborate__map" aria-hidden="true">
        <svg viewBox="0 0 1600 650" preserveAspectRatio="none">
          <path d="M-50 477c194-190 378-232 568-100 186 129 341 96 515-54 161-139 311-131 630-63" />
          <path d="M-60 548c206-145 371-142 554-39 195 110 359 88 527-41 181-139 327-112 655-50" />
          <circle cx="1033" cy="323" r="7" />
          <circle class="collaborate__ring" cx="1033" cy="323" r="36" />
        </svg>
      </div>
      <div class="shell collaborate__content" data-reveal>
        <p class="section-index section-index--light">08 — COLABORACIÓN</p>
        <h2 id="collaborate-title">Construido con quienes gestionan el agua.</h2>
        <p>Buscamos territorios con una decisión concreta, datos disponibles y una forma real de verificar qué sucedió en campo.</p>
        <div class="button-row">
          <a class="button button--paper" href="/ficha-piloto-hidrosat.md" download>Descargar ficha de piloto <span aria-hidden="true">↓</span></a>
          <a class="text-link text-link--light" href="#estado">Conocer la etapa actual <span aria-hidden="true">↑</span></a>
        </div>
        <small>El canal público de recepción se incorporará cuando esté definido. No publicamos aliados hasta que exista una relación formal.</small>
      </div>
    </section>

    <section class="closing" aria-label="Declaración final">
      <div class="shell" data-reveal>
        <p>Observar mejor.</p>
        <p>Llegar antes.</p>
        <p>Decidir con <em>evidencia.</em></p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
